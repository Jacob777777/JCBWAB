---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { excerpt } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const { title, pubDate, category, image } = post.data;
const description = post.data.description?.trim() || excerpt(post.body, 100) || title;
const fmt = pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={title} description={description} image={image} type="article" pubDate={pubDate}>
  <article class="mx-auto max-w-3xl rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-10">
    <a href="/" class="text-base text-indigo-700 hover:underline">← 回首頁</a>
    <p class="mt-4 inline-block rounded-full bg-indigo-100 px-3 py-1 text-base font-medium text-indigo-700">{category}</p>
    <h1 class="mt-1 text-3xl font-bold leading-tight sm:text-4xl">{title}</h1>
    <time class="mt-2 block text-base text-slate-500" datetime={pubDate.toISOString()}>{fmt}</time>

    <!-- 廣告預留位：標題下方（貼 AdSense 代碼於此 div 內） -->
    <div id="adsense-slot" class="ad-slot my-6"></div>

    {tocItems.length > 0 && (
      <nav aria-label="目錄" class="mt-6 mb-8 rounded-xl border border-gray-200 bg-gray-50 p-6 shadow-sm">
        <p class="mb-4 border-b border-gray-200 pb-3 text-lg font-bold">📑 目錄</p>
        <ul class="space-y-2.5 text-base">
          {tocItems.map((h) => (
            <li class={h.depth === 3 ? 'ml-4 text-[0.95rem]' : 'font-medium'}>
              <a href={'#' + h.slug} class="text-slate-700 transition-colors hover:text-blue-600 hover:underline">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="prose prose-slate mt-6 max-w-none prose-a:text-indigo-700">
      <Content />
    </div>

    <p class="mt-8 text-xs text-gray-400">
      本文部分連結為聯盟行銷連結，若您透過連結購買，本站將獲得微薄分潤，但這不會影響您的購買價格。
    </p>
  </article>
</Base>

