---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { excerpt } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, pubDate, category, image } = post.data;
const description = post.data.description?.trim() || excerpt(post.body, 100) || title;
const fmt = pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={title} description={description} image={image} type="article" pubDate={pubDate}>
  <article>
    <a href="/" class="text-base text-indigo-700">← 回首頁</a>
    <p class="mt-4 text-base text-indigo-700">{category}</p>
    <h1 class="mt-1 text-3xl font-bold leading-tight sm:text-4xl">{title}</h1>
    <time class="mt-2 block text-base text-slate-500" datetime={pubDate.toISOString()}>{fmt}</time>

    <!-- 廣告預留位：標題下方（貼 AdSense 代碼於此 div 內） -->
    <div id="adsense-slot" class="ad-slot my-6"></div>

    <div class="prose prose-slate mt-6 max-w-none prose-a:text-indigo-700">
      <Content />
    </div>
  </article>
</Base>

