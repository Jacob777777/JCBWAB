---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { excerpt, SITE_NAME } from '../lib/seo';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const categories = [...new Set(posts.map((p) => p.data.category))];
const fmt = (d: Date) => d.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
const [featured, ...rest] = posts;
---
<Base>
  <section class="mb-10 rounded-2xl bg-gradient-to-br from-indigo-600 to-violet-600 px-6 py-10 text-white shadow-lg sm:px-10 sm:py-14">
    <h1 class="text-3xl font-extrabold leading-tight sm:text-5xl">{SITE_NAME}</h1>
    <p class="mt-3 max-w-xl text-lg text-indigo-100">精選評測、比較與購買指南，幫你做出聰明的消費決策。</p>
    {categories.length > 0 && (
      <ul class="mt-6 flex flex-wrap gap-2" aria-label="分類">
        {categories.map((c) => (
          <li class="rounded-full bg-white/20 px-3 py-1 text-base backdrop-blur">{c}</li>
        ))}
      </ul>
    )}
  </section>

  {posts.length === 0 && <p class="text-center text-slate-500">尚無文章，請把 .md 檔放入 src/content/blog/。</p>}

  {featured && (
    <section class="mb-10" aria-label="精選文章">
      <h2 class="mb-4 text-xl font-bold">📌 最新精選</h2>
      <a href={`/blog/${featured.id}/`} class="group block rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md sm:p-8">
        <span class="inline-block rounded-full bg-indigo-100 px-3 py-1 text-base font-medium text-indigo-700">{featured.data.category}</span>
        <h3 class="mt-3 text-2xl font-bold leading-snug group-hover:text-indigo-700 sm:text-3xl">{featured.data.title}</h3>
        <p class="mt-3 text-base text-slate-600 sm:text-lg">{featured.data.description ?? excerpt(featured.body)}</p>
        <div class="mt-4 flex items-center justify-between text-base text-slate-500">
          <time datetime={featured.data.pubDate.toISOString()}>{fmt(featured.data.pubDate)}</time>
          <span class="font-medium text-indigo-700">閱讀全文 →</span>
        </div>
      </a>
    </section>
  )}

  {rest.length > 0 && (
    <section aria-label="更多文章">
      <h2 class="mb-4 text-xl font-bold">更多文章</h2>
      <ul class="grid gap-4 sm:grid-cols-2">
        {rest.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`} class="group block h-full rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
              <span class="text-base font-medium text-indigo-700">{p.data.category}</span>
              <h3 class="mt-1 text-xl font-bold leading-snug group-hover:text-indigo-700">{p.data.title}</h3>
              <p class="mt-2 text-base text-slate-600">{p.data.description ?? excerpt(p.body)}</p>
              <time class="mt-3 block text-base text-slate-500" datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
