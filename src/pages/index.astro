---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { excerpt, SITE_NAME } from '../lib/seo';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const categories = [...new Set(posts.map((p) => p.data.category))];
const fmt = (d: Date) => d.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base>
  <section class="mb-8">
    <h1 class="text-3xl font-bold leading-tight sm:text-4xl">{SITE_NAME}</h1>
    <p class="mt-2 text-lg text-slate-600">精選評測、比較與購買指南，幫你做出聰明的消費決策。</p>
  </section>

  <section class="mb-8" aria-label="分類">
    <h2 class="mb-3 text-xl font-semibold">文章分類</h2>
    <ul class="flex flex-wrap gap-2">
      {categories.map((c) => (
        <li class="rounded-full bg-indigo-100 px-3 py-1 text-base text-indigo-800">
          {c}（{posts.filter((p) => p.data.category === c).length}）
        </li>
      ))}
    </ul>
  </section>

  <section aria-label="最新文章">
    <h2 class="mb-4 text-xl font-semibold">最新文章</h2>
    {posts.length === 0 && <p>尚無文章，請把 .md 檔放入 src/content/blog/。</p>}
    <ul class="grid gap-4">
      {posts.map((p) => (
        <li class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <span class="text-base text-indigo-700">{p.data.category}</span>
          <h3 class="mt-1 text-xl font-bold leading-snug">
            <a href={`/blog/${p.id}/`} class="hover:text-indigo-700">{p.data.title}</a>
          </h3>
          <p class="mt-2 text-base text-slate-600">{p.data.description ?? excerpt(p.body)}</p>
          <time class="mt-2 block text-base text-slate-500" datetime={p.data.pubDate.toISOString()}>
            {fmt(p.data.pubDate)}
          </time>
        </li>
      ))}
    </ul>
  </section>
</Base>

